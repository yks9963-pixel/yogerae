# Anthropic API key used server-side by /api/scan.js — never expose to the frontend.
ANTHROPIC_API_KEY=

# Google Cloud Vision API key used server-side by /api/scan.js — never expose to the frontend.
GOOGLE_VISION_API_KEY=

# Optional override for the Claude model used for menu translation.
# Defaults to claude-haiku-4-5-20251001 if unset.
CLAUDE_MODEL=
