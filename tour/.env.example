# Gemini API key used server-side by /api/scan.js — never expose to the frontend.
# Get one from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override for the Gemini model used to read and translate the menu photo.
# Defaults to gemini-2.5-flash if unset. Must be a multimodal (image-capable) model.
GEMINI_MODEL=

# Comma-separated list of allowed browser Origin values for /api/scan (defense
# against off-site abuse). http(s)://localhost:* and http(s)://127.0.0.1:* are
# always allowed regardless of this list, for local dev.
ALLOWED_ORIGINS=https://tour-liart-alpha.vercel.app

# Vercel KV / Upstash Redis REST credentials, used for /api/scan rate limiting
# (5 requests/IP/minute). These are auto-injected by Vercel when you connect a
# KV/Upstash Redis database to this project in the dashboard — you normally
# don't set them by hand except for local `vercel dev` testing (`vercel env
# pull .env` or copy from Project Settings > Environment Variables). If unset,
# rate limiting is skipped (fails open) and scanning still works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names used by the "Upstash for Redis" marketplace integration —
# only needed if your dashboard generated these instead of the KV_* ones above.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
